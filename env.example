# Токен от @BotFather — заведи нового бота, не Mindgate
TELEGRAM_TOKEN=

# Кто может пользоваться: id через запятую. Свой id бот скажет сам, если написать ему без этой строки
ALLOWED_IDS=

# Куки YouTube (см. README). Содержимое cookies.txt целиком или он же в base64
YT_COOKIES=

# Свой сервер Bot API — файлы до 2 ГБ вместо 50 МБ (см. README, «Большие файлы»)
# LOCAL_BOT_API_URL=http://telegram-bot-api.railway.internal:8081

# Необязательное
# PARALLEL_DOWNLOADS=2      сколько файлов качать одновременно
# PLAYLIST_LIMIT=50         сколько треков брать из плейлиста за раз
# DATA_DIR=./data           где кэш и куки, если нет тома Railway
